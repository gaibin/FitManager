# 运行模式：local (本地IndexedDB) | cloud (云端Supabase) | mock (本地模拟)
VITE_DB_MODE=local

# 体态分析 Flask 后端
VITE_POSTURE_API_URL=http://localhost:5000
# 教练试点功能开关；设为 false 时前端禁用 V2
VITE_POSTURE_V2_ENABLED=true

# AI 教练配置：仅由服务端读取。密钥变量绝不能添加 VITE_ 前缀。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 云端模式 (可选)
VITE_SUPABASE_URL=你的_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=你的_SUPABASE_ANON_KEY
