# 运行模式：local (本地IndexedDB) | cloud (云端Supabase) | mock (本地模拟)
VITE_DB_MODE=local

# 体态分析 Flask 后端
VITE_POSTURE_API_URL=http://localhost:5000
# 教练试点功能开关；设为 false 时前端禁用 V2
VITE_POSTURE_V2_ENABLED=true

# AI 提供商配置
VITE_AI_PROVIDER=gemini
VITE_GEMINI_API_KEY=你的GEMINI_API_KEY
VITE_DEEPSEEK_API_KEY=你的DEEPSEEK_API_KEY
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_KIMI_API_KEY=你的KIMI_API_KEY
VITE_KIMI_BASE_URL=https://api.moonshot.cn/v1
VITE_KIMI_MODEL=moonshot-v1-8k

# 云端模式 (可选)
VITE_SUPABASE_URL=你的_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=你的_SUPABASE_ANON_KEY
